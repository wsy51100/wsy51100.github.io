{% comment %}
  Homepage selections: master thesis, two additional projects, one preprint,
  and the Bonn / Drone / Film Camera photography collections.
{% endcomment %}
<style>
  #home-selected {
    clear: both;
    display: flow-root;
    margin-top: 56px;
    padding-top: 34px;
    padding-bottom: 30px;
    border-top: 1px solid var(--global-divider-color);
    color: var(--global-text-color);
    font-size: 15px;
    line-height: 1.7;
  }
  #home-selected, #home-selected * { box-sizing: border-box; }
  #home-selected h2, #home-selected h3, #home-selected p, #home-selected figure { margin: 0; }
  #home-selected a { color: inherit; text-decoration: none; }
  #home-selected a:hover { color: var(--global-theme-color); }
  #home-selected img { display: block; width: 100%; height: auto; }
  #home-selected h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 27px;
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: -.025em;
  }
  #home-selected h3 { font-size: 16px; line-height: 1.5; font-weight: 400; }
  #home-selected .hs-section + .hs-section {
    margin-top: 34px;
    padding-top: 27px;
    border-top: 1px solid var(--global-divider-color);
  }
  #home-selected .hs-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 22px;
  }
  #home-selected .hs-view-all {
    color: var(--global-text-color-light);
    font-size: 12px;
    line-height: 1.5;
    white-space: nowrap;
  }
  #home-selected .hs-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 30px;
    align-items: center;
  }
  #home-selected .hs-feature > *, #home-selected .hs-project > *, #home-selected .hs-photographs > * { min-width: 0; }
  #home-selected .hs-feature-image {
    aspect-ratio: 1.65;
    max-height: 285px;
    object-fit: contain;
    border-radius: 4px;
  }
  #home-selected .hs-meta {
    font-size: 11px;
    line-height: 1.6;
    color: var(--global-text-color-light);
    margin-bottom: 7px;
  }
  #home-selected .hs-feature h3 {
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.28;
    font-weight: 400;
    letter-spacing: -.02em;
    overflow-wrap: break-word;
  }
  #home-selected .hs-summary { margin-top: 13px; font-size: 12px; color: var(--global-text-color-light); }
  #home-selected .hs-explore { display: inline-block; margin-top: 17px; font-size: 12px; color: var(--global-theme-color); }
  #home-selected .hs-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
    margin-top: 27px;
  }
  #home-selected .hs-project {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  #home-selected .hs-project img { aspect-ratio: 1.2; object-fit: contain; border-radius: 3px; }
  #home-selected .hs-project .hs-meta { margin-bottom: 4px; }
  #home-selected .hs-project h3 { font-size: 15px; line-height: 1.45; }
  #home-selected .hs-paper {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 18px;
    gap: 18px;
    align-items: start;
  }
  #home-selected .hs-year { font-size: 12px; line-height: 1.8; color: var(--global-text-color-light); }
  #home-selected .hs-paper h3 { font-size: 15px; line-height: 1.6; }
  #home-selected .hs-paper-meta { margin-top: 7px; font-size: 12px; color: var(--global-text-color-light); }
  #home-selected .hs-preprint { color: var(--global-theme-color); }
  #home-selected .hs-paper-arrow { font-size: 17px; line-height: 1.5; }
  #home-selected .hs-photographs {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.1fr;
    gap: 20px;
    align-items: end;
  }
  #home-selected .hs-photographs img { border-radius: 3px; }
  #home-selected .hs-caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: baseline;
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  #home-selected .hs-count { color: var(--global-text-color-light); font-size: 11px; white-space: nowrap; }
  @media (max-width: 760px) {
    #home-selected { margin-top: 36px; padding-top: 28px; }
    #home-selected .hs-feature { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    #home-selected .hs-feature-image { max-height: 340px; }
    #home-selected .hs-feature h3 { font-size: 23px; }
    #home-selected .hs-project { grid-template-columns: 80px minmax(0, 1fr); gap: 13px; }
  }
  @media (max-width: 620px) {
    #home-selected .hs-projects, #home-selected .hs-photographs { grid-template-columns: minmax(0, 1fr); gap: 25px; }
    #home-selected .hs-project { grid-template-columns: 105px minmax(0, 1fr); gap: 17px; }
    #home-selected .hs-paper { grid-template-columns: 38px minmax(0, 1fr); gap: 12px; }
    #home-selected .hs-paper-arrow { display: none; }
    #home-selected h2 { font-size: 25px; }
    #home-selected .hs-heading { gap: 12px; }
    #home-selected .hs-caption { font-size: 14px; }
  }
</style>

<section id="home-selected" aria-label="Selected projects, publication and photography">
  <section class="hs-section" aria-labelledby="home-projects-heading">
    <div class="hs-heading">
      <h2 id="home-projects-heading">Selected Projects</h2>
      <a class="hs-view-all" href="{{ '/projects/' | relative_url }}">All projects →</a>
    </div>
    <div class="hs-feature">
      <a href="{{ '/Master_Thesis/' | relative_url }}" aria-label="Read the master thesis: Leveraging Vision Foundation Models for Semantic Implicit Multi-Sensor SLAM">
        <img class="hs-feature-image" src="{{ '/assets/homepage/master-thesis.webp' | relative_url }}" width="831" height="496" alt="Semantic mapping visualization from the master thesis" loading="lazy" decoding="async">
      </a>
      <div>
        <p class="hs-meta">Master Thesis</p>
        <a href="{{ '/Master_Thesis/' | relative_url }}"><h3>Leveraging Vision Foundation Models for Semantic Implicit Multi-Sensor SLAM</h3></a>
        <p class="hs-summary">Semantic mapping · LiDAR–camera fusion · Implicit SLAM</p>
        <a class="hs-explore" href="{{ '/Master_Thesis/' | relative_url }}">Explore the thesis →</a>
      </div>
    </div>
    <div class="hs-projects">
      <a class="hs-project" href="{{ '/projects/2_project/' | relative_url }}">
        <img src="{{ '/assets/homepage/mobile-mapping.webp' | relative_url }}" width="960" height="504" alt="Point cloud from the mobile mapping system evaluation" loading="lazy" decoding="async">
        <div><p class="hs-meta">Course Project</p><h3>Mobile Mapping System Evaluation</h3></div>
      </a>
      <a class="hs-project" href="{{ '/projects/4_project/' | relative_url }}" aria-label="Undergraduate thesis: Research on the Application of Spatial Information Technology in the Digital Protection of Ancient Memorial Archway">
        <img src="{{ '/assets/homepage/undergraduate-thesis.webp' | relative_url }}" width="960" height="494" alt="Aerial view of the ancient memorial archway studied in the undergraduate thesis" loading="lazy" decoding="async">
        <div><p class="hs-meta">Undergraduate Thesis</p><h3>Digital Protection of Ancient Memorial Archway</h3></div>
      </a>
    </div>
  </section>

  <section class="hs-section" aria-labelledby="home-publication-heading">
    <div class="hs-heading">
      <h2 id="home-publication-heading">Publication</h2>
      <a class="hs-view-all" href="{{ '/publications/' | relative_url }}">All publications →</a>
    </div>
    <a class="hs-paper" href="https://www.preprints.org/manuscript/202611.0078/v1" target="_blank" rel="noopener">
      <span class="hs-year">2026</span>
      <div><h3>From Prediction to Control: A Survey of Closed-Loop World Models for Robot Learning</h3><p class="hs-paper-meta">Preprints.org · <span class="hs-preprint">Preprint</span></p></div>
      <span class="hs-paper-arrow" aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="hs-section" aria-labelledby="home-photography-heading">
    <div class="hs-heading">
      <h2 id="home-photography-heading">Photography</h2>
      <a class="hs-view-all" href="{{ '/photography/' | relative_url }}">All collections →</a>
    </div>
    <div class="hs-photographs">
      <a href="{{ '/photography/' | relative_url }}#album/b">
        <figure>
          <img src="{{ '/assets/photography/thumbs/b01.jpg' | relative_url }}?v=f4d777e93cf2" width="900" height="600" alt="Bonn and the Rhine at dusk" loading="lazy" decoding="async">
          <figcaption class="hs-caption"><span>Bonn, Germany</span><span class="hs-count">13 photographs</span></figcaption>
        </figure>
      </a>
      <a href="{{ '/photography/' | relative_url }}#album/dr">
        <figure>
          <img src="{{ '/assets/photography/thumbs/dr01.jpg' | relative_url }}?v=051927b3032f" width="900" height="506" alt="Drone photograph of a sandy shoreline and green water" loading="lazy" decoding="async">
          <figcaption class="hs-caption"><span>Pic from Drone</span><span class="hs-count">2 photographs</span></figcaption>
        </figure>
      </a>
      <a href="{{ '/photography/' | relative_url }}#album/f">
        <figure>
          <img src="{{ '/assets/photography/thumbs/f01.jpg' | relative_url }}?v=8348424e3775" width="900" height="612" alt="Film photograph of plants and hanging sheets inside a greenhouse" loading="lazy" decoding="async">
          <figcaption class="hs-caption"><span>Pics from Film Camera</span><span class="hs-count">21 photographs</span></figcaption>
        </figure>
      </a>
    </div>
  </section>
</section>
